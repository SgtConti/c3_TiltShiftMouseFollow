{
  "is-c3-addon": true,
  "sdk-version": 2,
  "type": "effect",
  "name": "Tilt Shift Mouse Follow",
  "id": "sgtconti_tilt_shift_mouse_follow",
  "version": "2.1.0.0",
  "author": "SgtConti",
  "website": "https://github.com/SgtConti/c3_TiltShiftMouseFollow",
  "documentation": "https://github.com/SgtConti/c3_TiltShiftMouseFollow",
  "description": "Tilt-shift band, ellipse focus, or radial focus following a layout position. Can sample the background when used as a layer effect. Supports WebGL and WebGPU.",
  "category": "other",
  "supported-renderers": ["webgl", "webgpu"],
  "blends-background": true,
  "must-predraw": true,
  "cross-sampling": true,
  "preserves-opaqueness": false,
  "animated": false,
  "parameters": [
    {"id": "mouseX", "type": "float", "initial-value": 0, "uniform": "mouseX", "interpolatable": false},
    {"id": "mouseY", "type": "float", "initial-value": 0, "uniform": "mouseY", "interpolatable": false},
    {"id": "angleDeg", "type": "float", "initial-value": 0, "uniform": "angleDeg", "interpolatable": true},
    {"id": "focusSize", "type": "float", "initial-value": 80, "uniform": "focusSize", "interpolatable": true},
    {"id": "transitionSize", "type": "float", "initial-value": 140, "uniform": "transitionSize", "interpolatable": true},
    {"id": "blurRadius", "type": "float", "initial-value": 10, "uniform": "blurRadius", "interpolatable": true},
    {"id": "intensity", "type": "percent", "initial-value": 1, "uniform": "intensity", "interpolatable": true},
    {"id": "mode", "type": "percent", "initial-value": 0, "uniform": "mode", "interpolatable": true},
    {"id": "ellipseAspect", "type": "float", "initial-value": 1, "uniform": "ellipseAspect", "interpolatable": true}
  ],
  "file-list": ["addon.json", "effect.fx", "effect.wgsl", "icon.svg", "lang/en-US.json"]
}
